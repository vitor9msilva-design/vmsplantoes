<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets só aceitam alguns tipos de elemento (LinearLayout, FrameLayout, TextView, ImageView...): não use <View>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/w_faixa"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:background="#1D4ED8"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- topo: rótulo e dia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/w_rotulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#64748B" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />

            <TextView android:id="@+id/w_dia" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_pilula" android:paddingStart="12dp" android:paddingTop="2dp"
                android:paddingEnd="12dp" android:paddingBottom="2dp" android:textColor="#1D4ED8" android:textSize="15sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>

        <!-- local e horário -->
        <TextView android:id="@+id/w_local" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#0B1220" android:textSize="27sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />

        <TextView android:id="@+id/w_quando" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#334155" android:textSize="17sp" android:maxLines="1" android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- números grandes: quanto falta e hora de sair -->
        <!-- espaço flexível: estica quando o widget é alto, some quando é baixo -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_cont_rot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#64748B" android:textSize="14sp" android:maxLines="1" />
                <TextView android:id="@+id/w_cont" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#1D4ED8" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/w_saia_bloco" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/w_saia_rot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#64748B" android:textSize="14sp" android:maxLines="1" android:text="Saia de casa até" />
                <TextView android:id="@+id/w_saia" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#0B1220" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- rodapé: o plantão seguinte -->
        <TextView android:id="@+id/w_depois" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#64748B" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
